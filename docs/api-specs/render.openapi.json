{
  "components": {
    "schemas": {
      "BatchRenderRequest": {
        "description": "Request body for a batch render operation.",
        "properties": {
          "commit_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Message"
          },
          "device_uuids": {
            "items": {
              "type": "string"
            },
            "title": "Device Uuids",
            "type": "array"
          },
          "max_concurrency": {
            "default": 20,
            "title": "Max Concurrency",
            "type": "integer"
          }
        },
        "required": [
          "device_uuids"
        ],
        "title": "BatchRenderRequest",
        "type": "object"
      },
      "BulkRenderResponse": {
        "description": "Response from a bulk render operation (render-all or batch).",
        "properties": {
          "failed_devices": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FailedDevice"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Devices that failed to queue",
            "title": "Failed Devices"
          },
          "max_concurrency": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Maximum concurrent renders (batch only)",
            "title": "Max Concurrency"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "queued_count": {
            "title": "Queued Count",
            "type": "integer"
          },
          "total_devices": {
            "default": 0,
            "description": "Total number of devices targeted",
            "title": "Total Devices",
            "type": "integer"
          }
        },
        "required": [
          "message",
          "queued_count"
        ],
        "title": "BulkRenderResponse",
        "type": "object"
      },
      "ConsumerInfo": {
        "description": "Consumer information model.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "num_ack_pending": {
            "title": "Num Ack Pending",
            "type": "integer"
          },
          "num_delivered": {
            "title": "Num Delivered",
            "type": "integer"
          },
          "num_pending": {
            "title": "Num Pending",
            "type": "integer"
          },
          "stream": {
            "title": "Stream",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "name",
          "stream",
          "subject",
          "num_pending",
          "num_ack_pending",
          "num_delivered"
        ],
        "title": "ConsumerInfo",
        "type": "object"
      },
      "ConsumerListResponse": {
        "description": "Consumer list response model.",
        "properties": {
          "consumers": {
            "items": {
              "$ref": "#/components/schemas/ConsumerInfo"
            },
            "title": "Consumers",
            "type": "array"
          }
        },
        "required": [
          "consumers"
        ],
        "title": "ConsumerListResponse",
        "type": "object"
      },
      "ConsumerResetResponse": {
        "description": "Consumer reset response model.",
        "properties": {
          "consumer_name": {
            "title": "Consumer Name",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "stream": {
            "title": "Stream",
            "type": "string"
          }
        },
        "required": [
          "consumer_name",
          "stream",
          "status",
          "message"
        ],
        "title": "ConsumerResetResponse",
        "type": "object"
      },
      "ConsumerType": {
        "description": "Valid consumer types for NATS consumer management.",
        "enum": [
          "dcim",
          "device",
          "template"
        ],
        "title": "ConsumerType",
        "type": "string"
      },
      "FailedDevice": {
        "description": "A device that failed to queue for rendering.",
        "properties": {
          "device_uuid": {
            "title": "Device Uuid",
            "type": "string"
          },
          "error": {
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "device_uuid",
          "error"
        ],
        "title": "FailedDevice",
        "type": "object"
      },
      "FileCommit": {
        "description": "A rendered file and the config store commit it produced.",
        "properties": {
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          }
        },
        "required": [
          "filename",
          "commit"
        ],
        "title": "FileCommit",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RenderRequest": {
        "description": "Request body for a render operation.",
        "properties": {
          "commit_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Message"
          }
        },
        "title": "RenderRequest",
        "type": "object"
      },
      "RenderResponse": {
        "description": "Response from a single device render operation.",
        "properties": {
          "updated_files": {
            "description": "Files that changed during the render",
            "items": {
              "$ref": "#/components/schemas/FileCommit"
            },
            "title": "Updated Files",
            "type": "array"
          }
        },
        "title": "RenderResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhoamiResponse": {
        "description": "Response shape for ``GET /whoami``.",
        "properties": {
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "user": {
            "title": "User",
            "type": "string"
          }
        },
        "required": [
          "user",
          "roles"
        ],
        "title": "WhoamiResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "description": "Bearer JWT used by CLI and machine clients on svc-* endpoints. Authentication is required by default, but deployments may disable it with [auth] required = false. Browser OIDC sessions, mTLS, SPIFFE identities, and trusted gateway identity headers may also satisfy authentication outside this generated client flow.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Render API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthcheck": {
      "get": {
        "description": "Execute healthcheck.",
        "operationId": "healthcheck_healthcheck_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Healthcheck Healthcheck Get",
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [],
        "summary": "Healthcheck"
      }
    },
    "/v1/admin/consumers": {
      "get": {
        "description": "List all consumers and their current status.",
        "operationId": "list_consumers_v1_admin_consumers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumerListResponse"
                }
              }
            },
            "description": "Operation successful"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List Consumers",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/consumers/reset-all": {
      "delete": {
        "description": "Delete every consumer so the running services recreate them at the stream head.",
        "operationId": "reset_all_consumers_v1_admin_consumers_reset_all_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConsumerResetResponse"
                  },
                  "title": "Response Reset All Consumers V1 Admin Consumers Reset All Delete",
                  "type": "array"
                }
              }
            },
            "description": "Operation successful"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Reset All Consumers",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/consumers/{consumer_type}": {
      "get": {
        "description": "Get detailed information about a specific consumer.",
        "operationId": "get_consumer_info_v1_admin_consumers__consumer_type__get",
        "parameters": [
          {
            "in": "path",
            "name": "consumer_type",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ConsumerType"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumerInfo"
                }
              }
            },
            "description": "Operation successful"
          },
          "403": {
            "description": "NATS account lacks the required consumer permission"
          },
          "404": {
            "description": "Consumer not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Consumer Info",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/consumers/{consumer_type}/reset": {
      "delete": {
        "description": "Delete a consumer so the running service recreates it at the stream head.",
        "operationId": "reset_consumer_v1_admin_consumers__consumer_type__reset_delete",
        "parameters": [
          {
            "in": "path",
            "name": "consumer_type",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ConsumerType"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumerResetResponse"
                }
              }
            },
            "description": "Operation successful"
          },
          "403": {
            "description": "NATS account lacks the required consumer permission"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Reset Consumer",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/render/all": {
      "post": {
        "description": "Queue renders for all render-enabled devices.",
        "operationId": "render_all_v1_render_all_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RenderRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkRenderResponse"
                }
              }
            },
            "description": "Render produced no diff"
          },
          "201": {
            "description": "Successfully rendered a new configuration version"
          },
          "202": {
            "description": "Successfully queued renders for all devices"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Could not acquire lock within timeout"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Render All",
        "tags": [
          "render"
        ]
      }
    },
    "/v1/render/batch": {
      "post": {
        "description": "Queue renders for a specific list of devices with optimized batch processing.",
        "operationId": "render_batch_v1_render_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRenderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkRenderResponse"
                }
              }
            },
            "description": "Render produced no diff"
          },
          "201": {
            "description": "Successfully rendered a new configuration version"
          },
          "202": {
            "description": "Successfully queued renders for all devices"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Could not acquire lock within timeout"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Render Batch",
        "tags": [
          "render"
        ]
      }
    },
    "/v1/render/{device_uuid}/render": {
      "post": {
        "description": "Perform a fresh render for a device.",
        "operationId": "render_v1_render__device_uuid__render_post",
        "parameters": [
          {
            "in": "path",
            "name": "device_uuid",
            "required": true,
            "schema": {
              "title": "Device Uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RenderRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderResponse"
                }
              }
            },
            "description": "Render produced no diff"
          },
          "201": {
            "description": "Successfully rendered a new configuration version"
          },
          "202": {
            "description": "Successfully queued renders for all devices"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Could not acquire lock within timeout"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Render",
        "tags": [
          "render"
        ]
      }
    },
    "/whoami": {
      "get": {
        "description": "Reflect the caller's identity as seen by this service.",
        "operationId": "whoami_whoami_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Current User Info"
      }
    }
  }
}
