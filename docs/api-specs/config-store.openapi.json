{
  "components": {
    "schemas": {
      "BatchConfigItem": {
        "description": "Single item in batch request.",
        "properties": {
          "author": {
            "description": "Author email",
            "title": "Author",
            "type": "string"
          },
          "commit_message": {
            "description": "Commit message",
            "title": "Commit Message",
            "type": "string"
          },
          "content": {
            "description": "Configuration file content",
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional timestamp for the version (defaults to current time)",
            "title": "Created At"
          },
          "file_type": {
            "$ref": "#/components/schemas/FileType",
            "default": "intended",
            "description": "Config file type (intended or backup)"
          },
          "filename": {
            "description": "File name",
            "title": "Filename",
            "type": "string"
          }
        },
        "required": [
          "filename",
          "content",
          "author",
          "commit_message"
        ],
        "title": "BatchConfigItem",
        "type": "object"
      },
      "BatchConfigRequest": {
        "description": "Batch config creation request.",
        "properties": {
          "files": {
            "description": "List of files to create/update",
            "items": {
              "$ref": "#/components/schemas/BatchConfigItem"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "BatchConfigRequest",
        "type": "object"
      },
      "BatchConfigResponse": {
        "description": "Batch config creation response.",
        "properties": {
          "created": {
            "description": "Successfully created/updated files",
            "items": {
              "$ref": "#/components/schemas/ConfigVersionResponse"
            },
            "title": "Created",
            "type": "array"
          },
          "skipped": {
            "description": "Paths that had no changes",
            "items": {
              "type": "string"
            },
            "title": "Skipped",
            "type": "array"
          }
        },
        "required": [
          "created"
        ],
        "title": "BatchConfigResponse",
        "type": "object"
      },
      "CacheStatusResponse": {
        "description": "Cache service status response.",
        "properties": {
          "cache_ttl": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cache TTL in seconds",
            "title": "Cache Ttl"
          },
          "dcim_connected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the selected DCIM client is available",
            "title": "Dcim Connected"
          },
          "enabled": {
            "description": "Whether cache service is enabled",
            "title": "Enabled",
            "type": "boolean"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Status message if disabled",
            "title": "Message"
          },
          "nautobot_connected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Legacy alias for dcim_connected",
            "title": "Nautobot Connected"
          },
          "redis_connected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether Redis is connected",
            "title": "Redis Connected"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "CacheStatusResponse",
        "type": "object"
      },
      "CacheTestErrorResponse": {
        "description": "Cache test response when there's an error.",
        "properties": {
          "device_uuid": {
            "description": "DCIM provider device identifier",
            "title": "Device Uuid",
            "type": "string"
          },
          "error": {
            "description": "Error message",
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error",
          "device_uuid"
        ],
        "title": "CacheTestErrorResponse",
        "type": "object"
      },
      "CacheTestFoundResponse": {
        "description": "Cache test response when device is found.",
        "properties": {
          "device_name": {
            "description": "Device name",
            "title": "Device Name",
            "type": "string"
          },
          "device_uuid": {
            "description": "DCIM provider device identifier",
            "title": "Device Uuid",
            "type": "string"
          },
          "found": {
            "default": true,
            "description": "Whether device was found",
            "title": "Found",
            "type": "boolean"
          },
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Platform name",
            "title": "Platform"
          },
          "site": {
            "description": "Site name",
            "title": "Site",
            "type": "string"
          }
        },
        "required": [
          "device_uuid",
          "device_name",
          "site",
          "platform"
        ],
        "title": "CacheTestFoundResponse",
        "type": "object"
      },
      "CacheTestNotFoundResponse": {
        "description": "Cache test response when device is not found.",
        "properties": {
          "device_uuid": {
            "description": "DCIM provider device identifier",
            "title": "Device Uuid",
            "type": "string"
          },
          "found": {
            "default": false,
            "description": "Whether device was found",
            "title": "Found",
            "type": "boolean"
          },
          "message": {
            "description": "Not found message",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "device_uuid",
          "message"
        ],
        "title": "CacheTestNotFoundResponse",
        "type": "object"
      },
      "ConfigCreateRequest": {
        "description": "Request to create/update a config file.",
        "properties": {
          "author": {
            "description": "Author email",
            "title": "Author",
            "type": "string"
          },
          "commit_message": {
            "description": "Commit message describing the change",
            "title": "Commit Message",
            "type": "string"
          },
          "content": {
            "description": "Configuration file content",
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional timestamp for the version (defaults to current time)",
            "title": "Created At"
          },
          "file_type": {
            "$ref": "#/components/schemas/FileType",
            "default": "intended",
            "description": "Config file type (intended or backup)"
          }
        },
        "required": [
          "content",
          "author",
          "commit_message"
        ],
        "title": "ConfigCreateRequest",
        "type": "object"
      },
      "ConfigResponse": {
        "description": "Response with full config data.",
        "properties": {
          "author": {
            "description": "Author email",
            "title": "Author",
            "type": "string"
          },
          "commit_message": {
            "description": "Commit message",
            "title": "Commit Message",
            "type": "string"
          },
          "content": {
            "description": "Configuration file content",
            "title": "Content",
            "type": "string"
          },
          "content_hash": {
            "description": "SHA256 hash of content",
            "title": "Content Hash",
            "type": "string"
          },
          "created_at": {
            "description": "Timestamp when version was created",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "device": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceMetadata"
              },
              {
                "type": "null"
              }
            ],
            "description": "Device metadata from the selected DCIM provider"
          },
          "device_uuid": {
            "description": "DCIM provider device identifier",
            "title": "Device Uuid",
            "type": "string"
          },
          "file_type": {
            "$ref": "#/components/schemas/FileType",
            "description": "Config file type (intended or backup)"
          },
          "filename": {
            "description": "File name",
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "description": "Config file ID",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "version": {
            "description": "Version number",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "device_uuid",
          "filename",
          "file_type",
          "version",
          "content",
          "content_hash",
          "author",
          "commit_message",
          "created_at"
        ],
        "title": "ConfigResponse",
        "type": "object"
      },
      "ConfigVersionResponse": {
        "description": "Response with version metadata.",
        "properties": {
          "author": {
            "description": "Author email",
            "title": "Author",
            "type": "string"
          },
          "commit_message": {
            "description": "Commit message",
            "title": "Commit Message",
            "type": "string"
          },
          "content_hash": {
            "description": "SHA256 hash of content",
            "title": "Content Hash",
            "type": "string"
          },
          "created_at": {
            "description": "Timestamp when version was created",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "file_type": {
            "$ref": "#/components/schemas/FileType",
            "description": "Config file type (intended or backup)"
          },
          "version": {
            "description": "Version number",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "file_type",
          "author",
          "commit_message",
          "created_at",
          "content_hash"
        ],
        "title": "ConfigVersionResponse",
        "type": "object"
      },
      "ConfigVersionsResponse": {
        "description": "Response with list of versions.",
        "properties": {
          "device": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceMetadata"
              },
              {
                "type": "null"
              }
            ],
            "description": "Device metadata from the selected DCIM provider"
          },
          "device_uuid": {
            "description": "DCIM provider device identifier",
            "title": "Device Uuid",
            "type": "string"
          },
          "filename": {
            "description": "File name",
            "title": "Filename",
            "type": "string"
          },
          "versions": {
            "description": "List of versions",
            "items": {
              "$ref": "#/components/schemas/ConfigVersionResponse"
            },
            "title": "Versions",
            "type": "array"
          }
        },
        "required": [
          "device_uuid",
          "filename",
          "versions"
        ],
        "title": "ConfigVersionsResponse",
        "type": "object"
      },
      "DeleteDeviceResponse": {
        "description": "Response for device config deletion.",
        "properties": {
          "deleted_versions": {
            "description": "Number of config versions deleted",
            "title": "Deleted Versions",
            "type": "integer"
          },
          "device_uuid": {
            "description": "DCIM provider device identifier",
            "title": "Device Uuid",
            "type": "string"
          },
          "message": {
            "description": "Human-readable result message",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "device_uuid",
          "deleted_versions",
          "message"
        ],
        "title": "DeleteDeviceResponse",
        "type": "object"
      },
      "DeviceLatestConfig": {
        "description": "Device with its latest config metadata.",
        "properties": {
          "active": {
            "default": true,
            "description": "Whether the device is currently active in nv-config-manager",
            "title": "Active",
            "type": "boolean"
          },
          "latest_author": {
            "description": "Author of latest change",
            "title": "Latest Author",
            "type": "string"
          },
          "latest_message": {
            "description": "Commit message of latest change",
            "title": "Latest Message",
            "type": "string"
          },
          "latest_update": {
            "description": "Latest config update timestamp",
            "title": "Latest Update",
            "type": "string"
          },
          "name": {
            "description": "Device name",
            "title": "Name",
            "type": "string"
          },
          "site": {
            "description": "Site name",
            "title": "Site",
            "type": "string"
          },
          "uuid": {
            "description": "DCIM provider device identifier",
            "title": "Uuid",
            "type": "string"
          }
        },
        "required": [
          "uuid",
          "name",
          "site",
          "latest_update",
          "latest_author",
          "latest_message"
        ],
        "title": "DeviceLatestConfig",
        "type": "object"
      },
      "DeviceMetadata": {
        "description": "Device metadata from the selected DCIM provider.",
        "properties": {
          "device_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Provider UI link for the device",
            "title": "Device Url"
          },
          "last_updated": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When metadata was last refreshed",
            "title": "Last Updated"
          },
          "name": {
            "description": "Device name",
            "title": "Name",
            "type": "string"
          },
          "nautobot_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Legacy alias for device_url when the selected provider is Nautobot",
            "title": "Nautobot Url"
          },
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Platform/OS name",
            "title": "Platform"
          },
          "primary_ip4": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Primary IPv4 address",
            "title": "Primary Ip4"
          },
          "rack": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Rack name",
            "title": "Rack"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Device role",
            "title": "Role"
          },
          "site": {
            "description": "Site name",
            "title": "Site",
            "type": "string"
          }
        },
        "required": [
          "name",
          "site"
        ],
        "title": "DeviceMetadata",
        "type": "object"
      },
      "DeviceUUID": {
        "description": "Provider-owned device identifier entry.\n\nThe class and response field names are retained for API compatibility.",
        "properties": {
          "uuid": {
            "description": "DCIM provider device identifier",
            "title": "Uuid",
            "type": "string"
          }
        },
        "required": [
          "uuid"
        ],
        "title": "DeviceUUID",
        "type": "object"
      },
      "DiffResponse": {
        "description": "Response with diff between two versions.",
        "properties": {
          "device": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceMetadata"
              },
              {
                "type": "null"
              }
            ],
            "description": "Device metadata from the selected DCIM provider"
          },
          "device_uuid": {
            "description": "DCIM provider device identifier",
            "title": "Device Uuid",
            "type": "string"
          },
          "diff": {
            "description": "Unified diff output",
            "title": "Diff",
            "type": "string"
          },
          "diff_stats": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Statistics about the diff",
            "title": "Diff Stats",
            "type": "object"
          },
          "filename": {
            "description": "File name",
            "title": "Filename",
            "type": "string"
          },
          "from_version": {
            "description": "Source version",
            "title": "From Version",
            "type": "integer"
          },
          "new_content": {
            "description": "Content of target version",
            "title": "New Content",
            "type": "string"
          },
          "old_content": {
            "description": "Content of source version",
            "title": "Old Content",
            "type": "string"
          },
          "to_version": {
            "description": "Target version",
            "title": "To Version",
            "type": "integer"
          }
        },
        "required": [
          "device_uuid",
          "filename",
          "from_version",
          "to_version",
          "diff",
          "old_content",
          "new_content",
          "diff_stats"
        ],
        "title": "DiffResponse",
        "type": "object"
      },
      "FileType": {
        "description": "Enum for config file types.",
        "enum": [
          "intended",
          "backup"
        ],
        "title": "FileType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "StatsResponse": {
        "description": "Database statistics response.",
        "properties": {
          "storage_bytes": {
            "description": "Total storage used in bytes (compressed)",
            "title": "Storage Bytes",
            "type": "integer"
          },
          "storage_mb": {
            "description": "Total storage used in MB (compressed)",
            "title": "Storage Mb",
            "type": "number"
          },
          "total_config_versions": {
            "description": "Total number of config file versions",
            "title": "Total Config Versions",
            "type": "integer"
          },
          "unique_devices": {
            "description": "Number of unique devices with configs",
            "title": "Unique Devices",
            "type": "integer"
          },
          "unique_files": {
            "description": "Number of unique config files (device + filename)",
            "title": "Unique Files",
            "type": "integer"
          }
        },
        "required": [
          "total_config_versions",
          "unique_devices",
          "unique_files",
          "storage_bytes",
          "storage_mb"
        ],
        "title": "StatsResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhoamiResponse": {
        "description": "Response shape for ``GET /whoami``.",
        "properties": {
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "user": {
            "title": "User",
            "type": "string"
          }
        },
        "required": [
          "user",
          "roles"
        ],
        "title": "WhoamiResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "description": "Bearer JWT used by CLI and machine clients on svc-* endpoints. Authentication is required by default, but deployments may disable it with [auth] required = false. Browser OIDC sessions, mTLS, SPIFFE identities, and trusted gateway identity headers may also satisfy authentication outside this generated client flow.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "PostgreSQL-backed configuration storage service",
    "title": "Config Store API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/cache/status": {
      "get": {
        "description": "Check if cache service is initialized and working.",
        "operationId": "cache_status_v1_admin_cache_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Check cache service status",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/cache/test/{device_uuid}": {
      "get": {
        "description": "Test if a specific device can be found in cache.",
        "operationId": "test_cache_lookup_v1_admin_cache_test__device_uuid__get",
        "parameters": [
          {
            "in": "path",
            "name": "device_uuid",
            "required": true,
            "schema": {
              "title": "Device Uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CacheTestFoundResponse"
                    },
                    {
                      "$ref": "#/components/schemas/CacheTestNotFoundResponse"
                    },
                    {
                      "$ref": "#/components/schemas/CacheTestErrorResponse"
                    }
                  ],
                  "title": "Response Test Cache Lookup V1 Admin Cache Test  Device Uuid  Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Test cache lookup for a device",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/devices": {
      "get": {
        "description": "List all devices with configs.",
        "operationId": "list_devices_v1_admin_devices_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceUUID"
                  },
                  "title": "Response List Devices V1 Admin Devices Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List all devices",
