              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Config"
      }
    },
    "/healthcheck": {
      "get": {
        "description": "Readiness probe (strict): Kea online AND desired config applied.\n\nGates both pod readiness and the externally exposed NLB health endpoint. A\npod becomes ready -- and therefore a valid external DHCP target -- only when\nKea is online AND the expected desired configuration has been successfully\napplied/verified. An unconfigured pod (bootstrap config only) is never ready.\n\nA config mismatch makes the pod UNREADY (triggering reconciliation) but does\nNOT restart a live Kea; the readiness path never recycles the Kea container.",
        "operationId": "healthcheck_healthcheck_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Healthcheck Healthcheck Get",
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [],
        "summary": "Healthcheck"
      }
    },
    "/lease": {
      "get": {
        "description": "Return a cursor-paginated, optionally filtered page of normalized leases.",
        "operationId": "list_leases_lease_get",
        "parameters": [
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/IpVersion",
              "default": 4
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          },
          {
            "in": "query",
            "name": "subnet",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "ipvanynetwork",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Subnet"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeasePageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List Leases"
      }
    },
