{
  "components": {
    "schemas": {
      "DhcpSummaryResponse": {
        "description": "Lease, reservation, and pool summary.",
        "properties": {
          "active_lease_count": {
            "title": "Active Lease Count",
            "type": "integer"
          },
          "pool_count": {
            "title": "Pool Count",
            "type": "integer"
          },
          "reservation_count": {
            "title": "Reservation Count",
            "type": "integer"
          }
        },
        "required": [
          "active_lease_count",
          "reservation_count",
          "pool_count"
        ],
        "title": "DhcpSummaryResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IpVersion": {
        "description": "Supported DHCP address families.",
        "enum": [
          4,
          6
        ],
        "title": "IpVersion",
        "type": "integer",
        "x-enum-varnames": [
          "V4",
          "V6"
        ]
      },
      "LeasePageResponse": {
        "description": "Bounded page of normalized leases.",
        "properties": {
          "leases": {
            "items": {
              "$ref": "#/components/schemas/LeaseRecord"
            },
            "title": "Leases",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "leases"
        ],
        "title": "LeasePageResponse",
        "type": "object"
      },
      "LeaseRecord": {
        "description": "Active lease returned by the DHCP service.",
        "properties": {
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "cltt": {
            "title": "Cltt",
            "type": "integer"
          },
          "duid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duid"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "hostname": {
            "default": "",
            "title": "Hostname",
            "type": "string"
          },
          "hw_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hw Address"
          },
          "ip_address": {
            "format": "ipvanyaddress",
            "title": "Ip Address",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "integer"
          },
          "subnet": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subnet"
          },
          "valid_lft": {
            "title": "Valid Lft",
            "type": "integer"
          }
        },
        "required": [
          "ip_address",
          "state",
          "cltt",
          "valid_lft",
          "expires_at"
        ],
        "title": "LeaseRecord",
        "type": "object"
      },
      "PoolPageResponse": {
        "description": "Bounded page of configured pools.",
        "properties": {
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "pools": {
            "items": {
              "$ref": "#/components/schemas/PoolRecord"
            },
            "title": "Pools",
            "type": "array"
          },
          "total_count": {
            "title": "Total Count",
            "type": "integer"
          }
        },
        "required": [
          "pools",
          "total_count"
        ],
        "title": "PoolPageResponse",
        "type": "object"
      },
      "PoolRecord": {
        "description": "Configured address pool.",
        "properties": {
          "pool": {
            "title": "Pool",
            "type": "string"
          },
          "subnet": {
            "title": "Subnet",
            "type": "string"
          }
        },
        "required": [
          "subnet",
          "pool"
        ],
        "title": "PoolRecord",
        "type": "object"
      },
      "ReservationPageResponse": {
        "description": "Bounded page of normalized reservations.",
        "properties": {
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "reservations": {
            "items": {
              "$ref": "#/components/schemas/ReservationRecord"
            },
            "title": "Reservations",
            "type": "array"
          },
          "total_count": {
            "title": "Total Count",
            "type": "integer"
          }
        },
        "required": [
          "reservations",
          "total_count"
        ],
        "title": "ReservationPageResponse",
        "type": "object"
      },
      "ReservationRecord": {
        "description": "Configured address reservation.",
        "properties": {
          "hostname": {
            "default": "",
            "title": "Hostname",
            "type": "string"
          },
          "identifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Identifier"
          },
          "identifier_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Identifier Type"
          },
          "ip_address": {
            "anyOf": [
              {
                "format": "ipvanyaddress",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Address"
          },
          "subnet": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subnet"
          }
        },
        "title": "ReservationRecord",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhoamiResponse": {
        "description": "Response shape for ``GET /whoami``.",
        "properties": {
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "user": {
            "title": "User",
            "type": "string"
          }
        },
        "required": [
          "user",
          "roles"
        ],
        "title": "WhoamiResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "description": "Bearer JWT used by CLI and machine clients on svc-* endpoints. Authentication is required by default, but deployments may disable it with [auth] required = false. Browser OIDC sessions, mTLS, SPIFFE identities, and trusted gateway identity headers may also satisfy authentication outside this generated client flow.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "DHCP API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/cache": {
      "delete": {
        "description": "Flush the cached KEA DHCP configuration from Redis.",
        "operationId": "flush_cache_admin_cache_delete",
        "parameters": [
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "default": 4,
              "title": "Ip Version",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Flush Cache Admin Cache Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Flush Cache"
      }
    },
    "/config": {
      "get": {
        "description": "Get the running KEA DHCP Configuration.",
        "operationId": "get_config_config_get",
        "parameters": [
          {
            "in": "query",
