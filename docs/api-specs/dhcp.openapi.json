    "/livez": {
      "get": {
        "description": "Liveness probe for the Kea container.\n\nOnly checks that the Kea DHCP process/control channel is alive. A config\nmismatch (desired config not yet applied) must NOT fail this probe, because\nliveness failures recycle the Kea container; config correctness is enforced\nseparately by the readiness probe (``/healthcheck``).",
        "operationId": "livez_livez_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Livez Livez Get",
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [],
        "summary": "Livez"
      }
    },
