# NVIDIA Config Manager operator and dependency versions.
# This file is the source of truth for the Python installer and airgap bundle creation.

# Gateway API v1.5 includes breaking changes around TLSRoute/XListenerSet upgrades.
GATEWAY_API_VERSION=v1.4.1

# Envoy Gateway v1.6.6 and v1.7 include breaking behavior changes; stay on v1.6.5.
ENVOY_GATEWAY_VERSION=v1.6.5

CERT_MANAGER_VERSION=v1.20.2
CNPG_OPERATOR_VERSION=0.28.0
PROMETHEUS_CRD_VERSION=v0.90.1
PROMETHEUS_OPERATOR_VERSION=84.5.0

# Local security stack used by make kind-up-sec.
SPIRE_CRDS_VERSION=0.5.0
SPIRE_VERSION=0.29.0
KEYCLOAK_CONFIG_IMAGE=curlimages/curl:8.15.0
OPENBAO_CHART_VERSION=0.29.3
