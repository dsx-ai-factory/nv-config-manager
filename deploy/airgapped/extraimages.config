# Extra images pulled dynamically by operators (not in chart templates)

# cert-manager dynamic ACME solver image (passed to controller as an argument)
quay.io/jetstack/cert-manager-acmesolver:v1.20.2

# CloudNative-PG database images (pulled by CNPG operator)
ghcr.io/cloudnative-pg/pgbouncer:1.22.1
ghcr.io/cloudnative-pg/postgresql:18.0-system-trixie

# Envoy Gateway images (controller, ratelimit, shutdown-manager, proxy)
# Must match ENVOY_GATEWAY_VERSION in ../operator-versions.env
# v1.6.5 uses Envoy v1.36.5 - check release notes for updates:
# https://gateway.envoyproxy.io/docs/releases/
docker.io/envoyproxy/gateway:v1.6.5
docker.io/envoyproxy/ratelimit:c8765e89
docker.io/envoyproxy/envoy:distroless-v1.36.5

# Elasticsearch (if using Temporal with ES backend)
docker.io/library/elasticsearch:7.17.22

# Image loader DaemonSet (used for airgapped deployment)
docker.io/library/busybox:1.36

# =============================================================================
# Envoy Gateway Data Plane Images
# =============================================================================
# The DATA PLANE proxy image is spawned dynamically when Gateway resources
# are created. This image MUST be listed here explicitly as it's not in the
# Helm chart templates.
#
# Check the Envoy Gateway release notes for the correct envoy version:
# https://gateway.envoyproxy.io/docs/releases/
docker.io/envoyproxy/envoy:distroless-v1.36.5

# =============================================================================
# Prometheus Operator Images (for optional monitoring dependencies)
# =============================================================================
# Most images are extracted from the kube-prometheus-stack chart templates.
# These are additional images that may be dynamically created by the operator
# or used as sidecars.
#
# Note: Grafana is excluded (AGPL license). We disable it with:
#   --set grafana.enabled=false
#
# Prometheus config reloader sidecar (injected into Prometheus/Alertmanager pods)
quay.io/prometheus-operator/prometheus-config-reloader:v0.90.1

# Permissive local observability images. Grafana and Loki are intentionally
# excluded from default bundles because their OSS distributions are AGPLv3.
quay.io/prometheus/prometheus:v3.11.3
docker.io/grafana/alloy:v1.16.0

# Curl image for in-cluster API calls (used by installer-managed job execution)
docker.io/curlimages/curl:latest

# Installs external DCIM provider wheels into the shared provider volume.
docker.io/library/python:3.13-bookworm
