    vrf:
{% for vrf in device_data|attached_vrfs %}
{% set lo_intf = device_data|interface_by_name("lo-" + vrf.name|lower, false) %}
{% if lo_intf %}
      {{ vrf.name }}:
{% if vrf.vni and device_data | l3vni_mappings(vrf.name) %}
        evpn:
          state: enabled
          vlan: {{ device_data | l3vni_mappings(vrf.name) }}
          vni:
            '{{ vrf.vni }}': {}
{% endif %}
        loopback:
          ipv4:
            address:
              {{ lo_intf.primary_ipv4 }}: {}
        router:
          bgp:
            address-family:
              ipv4-unicast:
                state: enabled
                redistribute:
                  connected:
                    state: enabled
                route-export:
                  to-evpn:
                    state: enabled
{% if device_data|role == "Border-Leaf" and vrf.name != "STORAGE" %}
                route-import:
                  from-vrf:
                    state: enabled
                    list:
{% if vrf.name == "OOB" %}
                      EXIT: {}
{% elif vrf.name == "EXIT" %}
                      INBAND: {}
{% elif vrf.name == "INBAND" %}
                      EXIT: {}
{% endif %}
{% endif %}
{% if device_data|role == "OOB-Spine" %}
                route-import:
                  from-vrf:
                    state: enabled
                    list:
{% if vrf.name == "OOB" %}
                      EXIT: {}
{% elif vrf.name == "EXIT" %}
                      OOB: {}
{% endif %}
{% endif %}
              l2vpn-evpn:
                state: enabled
            state: enabled
{% if vrf.name == "EXIT" %}
{% set exit_peers = (device_data|bgp_routing_instance(vrf=vrf.name)).peers | sort(attribute="peer_ipv4") %}
{% if exit_peers %}
            neighbor:
{% for peer in exit_peers %}
              {{ peer.peer_ipv4 }}:
                address-family:
                  ipv4-unicast:
                    aspath:
                      private-as: remove
                    policy:
                      inbound:
                        route-map: rm-default-only
                      outbound:
                        route-map: rm-edge-egress
                remote-as: external
                type: numbered
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
      default:
        evpn:
          state: enabled
        router:
          bgp:
            address-family:
              ipv4-unicast:
                state: enabled
                redistribute:
                  connected:
                    state: enabled
                    route-map: RM_LOOPBACK
              l2vpn-evpn:
                state: enabled
            state: enabled
            neighbor:
{% for peer in (device_data|bgp_routing_instance(vrf="default")).peers | sort(attribute="peer_ipv4") %}
              {{ peer.peer_ipv4 }}:
                peer-group: {{ peer.peer_group }}
                type: numbered
{% endfor %}
            path-selection:
              multipath:
                aspath-ignore: enabled
            peer-group:
              EVPN:
                address-family:
                  ipv4-unicast:
                    state: disabled
                  l2vpn-evpn:
                    state: enabled
                bfd:
                  profile: default-bfd-multihop
                description: evpn_vxlan_control_plane
                multihop-ttl: 2
                remote-as: external
                update-source: lo
              UNDERLAY:
                address-family:
                  ipv4-unicast:
                    policy:
                      outbound:
{% if device_data|role == "Converged-Spine" %}
                        route-map: RM_SUM_WECMP
{% else %}
                        route-map: RM_ADD_WECMP
{% endif %}
                bfd:
                  profile: default-bfd
                description: underlay_interconnect
                remote-as: external
{% block mgmt_vrf %}
      mgmt:
        router:
          static:
            0.0.0.0/0:
              address-family: ipv4-unicast
              via:
{% for gateway_ip in device_data|default_gateways %}
                {{ gateway_ip }}:
                  type: ipv4-address
{% endfor %}
{% endblock mgmt_vrf %}
