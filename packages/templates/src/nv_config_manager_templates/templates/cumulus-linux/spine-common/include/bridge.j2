    bridge:
      domain:
        br_default:
          stp:
            priority: 28672
            state:
              up: {}
{% if device_data|role in ["Border-Leaf", "Storage-Leaf", "OOB-Spine"] %}
          vlan:
{% for vlan_intf in device_data|interfaces(prefix="vlan") %}
            '{{ vlan_intf.vlan_number }}':
              vni:
                '{{ device_data | vni_mappings(vlan_intf.vlan_number) }}': {}
{% endfor %}
{% else %}
          vlan: {}
{% endif %}