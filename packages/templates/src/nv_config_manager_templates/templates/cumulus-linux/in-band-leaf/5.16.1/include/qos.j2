{% block qos %}
{% if device_data|interfaces(vrf="STORAGE") %}
    qos:
      pfc:
        default-global:
          port-buffer: 363000
          switch-priority:
            '3': {}
          xoff-threshold: 75000
          xon-threshold: 75000
      roce:
        state: enabled
      traffic-pool:
        default-lossy:
          memory-percent: 10
        roce-lossless:
          memory-percent: 90
{% endif %}
{% endblock qos %}
