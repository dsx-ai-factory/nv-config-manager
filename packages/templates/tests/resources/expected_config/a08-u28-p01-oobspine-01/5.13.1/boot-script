#!/bin/bash
function error() {
  echo -e "\e[0;33mERROR: The ZTP script failed while running the command $BASH_COMMAND at line $BASH_LINENO.\e[0m" >&2
  exit 1
}
function retry_curl() {
  local max_attempts=5
  local attempt=1
  local exit_code=0
  local output=""
  
  while [ $attempt -le $max_attempts ]; do
    echo "Attempt $attempt of $max_attempts: curl $*" >&2
    # Retry 5xx errors from the server
    output=$(curl --retry 5 --retry-delay 5 "$@" 2>/dev/null)
    exit_code=$?
    
    if [ $exit_code -eq 0 ]; then
      echo "$output"
      return 0
    elif [ $exit_code -eq 7 ]; then
      echo "curl failed with exit code 7 (connection failed) on attempt $attempt" >&2
      if [ $attempt -lt $max_attempts ]; then
        echo "Retrying in 10 seconds..." >&2
        sleep 10
      fi
    else
      echo "curl failed with exit code $exit_code on attempt $attempt" >&2
      return $exit_code
    fi
    
    attempt=$((attempt + 1))
  done
  
  echo "curl command failed after $max_attempts attempts" >&2
  return $exit_code
}
# Log all output from this script
exec >> /var/log/autoprovision 2>&1
date "+%FT%T ztp starting script $0"
trap error ERR
# Check current image and upgrade firmware first if needed
if ! grep -q "VERSION_ID=5.13.1" /etc/os-release; then
  FIRMWARE_REBOOT_MARKER="/tmp/ztp-firmware-reboot-pending"
  if [ -f "$FIRMWARE_REBOOT_MARKER" ]; then
    echo "Firmware installation already completed; waiting for reboot."
    exit 0
  fi
  # Load firmware with onie and reboot, DHCP will run after reboot
  FIRMWARE_URL="http://192.0.2.10/v1/device/8096224f-96b0-4f65-8b3e-2f3c4f47d1c4/firmware"
  if /usr/cumulus/bin/onie-install -fa -i "$FIRMWARE_URL"; then
    touch "$FIRMWARE_REBOOT_MARKER"
    if ! reboot; then
      rm -f "$FIRMWARE_REBOOT_MARKER"
      echo "Failed to initiate reboot."
      exit 1
    fi
    exit 0
  else
    echo "Firmware installation failed with exit code $?"
    exit 1
  fi
fi
#Add Debian Repositories
grep -qxF "deb http://http.us.debian.org/debian buster main" /etc/apt/sources.list || \
  echo "deb http://http.us.debian.org/debian buster main" >> /etc/apt/sources.list
grep -qxF "deb http://security.debian.org/ buster/updates main" /etc/apt/sources.list || \
  echo "deb http://security.debian.org/ buster/updates main" >> /etc/apt/sources.list
# Update Package Cache
# Disabling for now
# apt-get update -y
# Create a temporary breakglass user 
echo "Creating breakglass user"
useradd --groups cdrom,floppy,sudo,audio,dip,video,plugdev --shell /bin/bash --create-home breakglass || echo "breakglass user already exists"
echo 'breakglass:$6$H0QFj2rx$nZvUivJum/KP/YIvEu1iyuDUZcFGc48GMnoaAqrtW/dwbVtDsdqF1xCOD.eIR1ukFxwoLzze9PHGPDK0f2KHt.' | chpasswd --encrypted
# Cleanup any non-NVUE users
for USER in cumulus nv-config-manager ; do
    if id -u $USER; then
        APPLIED_ROLE=$(nv show system aaa user $USER | grep role | awk '{print $3}')
        if [ "$APPLIED_ROLE" = "" ]; then
            echo "The $USER is not cumulus controlled, deleting..."
            userdel -r $USER
        fi
    else
        echo "User $USER does not exist, skipping..."
    fi
done
# Validate Serial Number before applying configuration
SERIAL=$(nv show platform | grep serial-number | awk '{print $2}')
JSON_PAYLOAD=$(SERIAL="$SERIAL" python3 -c 'import json, os; print(json.dumps({"serial": os.environ["SERIAL"]}))')
retry_curl --fail -H "Content-Type: application/json" -d "$JSON_PAYLOAD" \
http://192.0.2.10/v1/device/8096224f-96b0-4f65-8b3e-2f3c4f47d1c4/validate_serial
#Load configuration from ZTP server
retry_curl --fail http://192.0.2.10/v1/device/8096224f-96b0-4f65-8b3e-2f3c4f47d1c4/config/startup.yaml -o /tmp/startup.yaml
nv config replace /tmp/startup.yaml
nv config apply -y
#Reload DHCP to workaround Cumulus 5.11.0 bug 4423269
dhclient -r
#Reload interfaces to apply loaded config
ifreload -fa
# Move state to Provisioned in Nautobot
retry_curl -X POST http://192.0.2.10/v1/device/8096224f-96b0-4f65-8b3e-2f3c4f47d1c4/provisioned
# Delete breakglass user
echo "Cleaning up breakglass user"
userdel -r breakglass
# CUMULUS-AUTOPROVISIONING
exit 0