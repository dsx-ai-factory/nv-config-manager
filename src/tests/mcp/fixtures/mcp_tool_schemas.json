{
  "run_backup": {
    "input_schema": {
      "$defs": {
        "TriggerEnum": {
          "description": "Enum of potential backup triggers.",
          "enum": [
            "SCHEDULED",
            "SYSLOG",
            "WORKFLOW",
            "API"
          ],
          "title": "TriggerEnum",
          "type": "string"
        }
      },
      "description": "Backup Workflow Input Definiton.",
      "properties": {
        "device_id": {
          "description": "Identifier of the network device to back up.",
          "title": "Device Id",
          "type": "string"
        },
        "intended_config_commit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Config Store commit containing the intended configuration.",
          "title": "Intended Config Commit Id"
        },
        "suppress_drift_notification": {
          "default": false,
          "description": "Suppress the Slack notification when configuration drift is detected.",
          "title": "Suppress Drift Notification",
          "type": "boolean"
        },
        "terminate_on_failure": {
          "default": false,
          "description": "Terminate the workflow instead of waiting to retry a failed stage.",
          "title": "Terminate On Failure",
          "type": "boolean"
        },
        "trigger": {
          "$ref": "#/$defs/TriggerEnum",
          "default": "API",
          "description": "Reason the backup workflow was started."
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "User that requested the backup.",
          "title": "User"
        },
        "user_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Domain of the user requesting the backup.",
          "title": "User Domain"
        },
        "workflow_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Identifier of the parent workflow, if any.",
          "title": "Workflow Id"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "BackupInput",
      "type": "object"
    },
    "tool_input_schema": {
      "$defs": {
        "TriggerEnum": {
          "description": "Enum of potential backup triggers.",
          "enum": [
            "SCHEDULED",
            "SYSLOG",
            "WORKFLOW",
            "API"
          ],
          "title": "TriggerEnum",
          "type": "string"
        }
      },
      "properties": {
        "device_id": {
          "description": "Identifier of the network device to back up.",
          "title": "Device Id",
          "type": "string"
        },
        "intended_config_commit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Config Store commit containing the intended configuration.",
          "title": "Intended Config Commit Id"
        },
        "suppress_drift_notification": {
          "default": false,
          "description": "Suppress the Slack notification when configuration drift is detected.",
          "title": "Suppress Drift Notification",
          "type": "boolean"
        },
        "terminate_on_failure": {
          "default": false,
          "description": "Terminate the workflow instead of waiting to retry a failed stage.",
          "title": "Terminate On Failure",
          "type": "boolean"
        },
        "trigger": {
          "$ref": "#/$defs/TriggerEnum",
          "default": "API",
          "description": "Reason the backup workflow was started."
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "User that requested the backup.",
          "title": "User"
        },
        "user_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Domain of the user requesting the backup.",
          "title": "User Domain"
        },
        "workflow_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Identifier of the parent workflow, if any.",
          "title": "Workflow Id"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "run_backupArguments",
      "type": "object"
    },
    "workflow": "BackupWorkflow"
  },
