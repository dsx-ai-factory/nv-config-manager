#!/usr/bin/env bash

set -euo pipefail

commit="${1:?commit is required}"
target_version="${2:?target version is required}"
default_branch="${3:?default branch is required}"
default_ref="origin/${default_branch}"
release_ref="origin/release/${target_version}"

if ! [[ "$target_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Target version must match X.Y.Z. Got: ${target_version}"
  exit 1
fi
IFS=. read -r target_major target_minor target_patch <<< "$target_version"

if git merge-base --is-ancestor "$commit" "$default_ref"; then
  exit 0
fi

if ! git rev-parse --verify "${release_ref}^{commit}" >/dev/null 2>&1; then
  echo "Maintenance release branch ${release_ref} does not exist."
  exit 1
fi
if [ "$(git rev-parse "${release_ref}^{commit}")" != "$commit" ]; then
  echo "Release commit ${commit} must be the exact tip of ${release_ref}."
  exit 1
fi

base_tag=""
while IFS= read -r tag; do
  tag_patch="${tag##*.}"
  if [ "$tag_patch" -ge "$target_patch" ]; then
    continue
  fi
  if git merge-base --is-ancestor "${tag}^{commit}" "$commit"; then
    base_tag="$tag"
    break
  fi
done < <(
  git tag --list "${target_major}.${target_minor}.*" \
    | grep -E "^${target_major}\\.${target_minor}\\.[0-9]+$" \
    | sort -Vr
)

if [ -z "$base_tag" ]; then
  echo "No earlier ${target_major}.${target_minor}.x stable tag is an ancestor of ${commit}; use the normal main release flow."
  exit 1
fi

merge_commits="$(git rev-list --min-parents=2 "${base_tag}..${commit}")"
if [ -n "$merge_commits" ]; then
  echo "Maintenance release history ${base_tag}..${commit} contains merge commits:"
  printf '%s\n' "$merge_commits"
  exit 1
fi

patch_matches_default() {
  local candidate="$1"
  local candidate_patch_id candidate_paths_text default_patch_id default_paths_text
  local default_candidate path start_parent
  local start_index end_index window_size
  local -a candidate_paths default_candidates

  candidate_patch_id="$(
    git show --root --format= --unified=0 "$candidate" -- . ':!CHANGELOG.md' \
      | git patch-id --verbatim \
      | awk 'NR == 1 { print $1 }'
  )"
  if [ -z "$candidate_patch_id" ]; then
    return 1
  fi

  while IFS= read -r path; do
    candidate_paths+=("$path")
  done < <(
    git diff-tree --no-commit-id --name-only -r "$candidate" \
      | grep -v '^CHANGELOG.md$'
  )
  if [ "${#candidate_paths[@]}" -eq 0 ]; then
    return 1
  fi
  candidate_paths_text="$(printf '%s\n' "${candidate_paths[@]}" | LC_ALL=C sort)"

  # Limit the search to first-parent commits that touch the candidate paths.
  # Comparing the full diff between each pair of endpoints still rejects any
  # unrelated changes made by commits between them.
  while IFS= read -r default_candidate; do
    default_candidates+=("$default_candidate")
  done < <(
    git rev-list --first-parent --reverse "$default_ref" -- "${candidate_paths[@]}"
  )

  # Search shorter ranges first because a maintenance commit normally maps to
  # one default-branch commit or a small squash. Zero-context verbatim patch
  # IDs ignore baseline-only hunk offsets while preserving every changed line.
  for ((window_size = 1; window_size <= ${#default_candidates[@]}; window_size++)); do
    for ((start_index = 0; start_index + window_size <= ${#default_candidates[@]}; start_index++)); do
      end_index=$((start_index + window_size - 1))
      start_parent="$(
        git rev-parse "${default_candidates[$start_index]}^" 2>/dev/null \
          || true
      )"
      if [ -z "$start_parent" ]; then
        continue
      fi
      default_paths_text="$(
        git diff --no-renames --name-only \
          "$start_parent" "${default_candidates[$end_index]}" \
          -- . ':!CHANGELOG.md' \
          | LC_ALL=C sort
      )"
      if [ "$candidate_paths_text" != "$default_paths_text" ]; then
        continue
      fi
      default_patch_id="$(
        git diff --no-renames --unified=0 \
          "$start_parent" "${default_candidates[$end_index]}" \
          -- . ':!CHANGELOG.md' \
          | git patch-id --verbatim \
          | awk 'NR == 1 { print $1 }'
      )"
      if [ "$candidate_patch_id" = "$default_patch_id" ]; then
        return 0
      fi
    done
  done

  return 1
}

added_lines() {
  local from="$1"
  local to="$2"

  git diff --no-renames --unified=0 "$from" "$to" -- . ':!CHANGELOG.md' \
    | awk '
      /^diff --git / { in_hunk = 0; next }
      /^@@ / { in_hunk = 1; next }
      in_hunk && /^\+/ { print substr($0, 2) }
    '
}

approved_backport_matches_default() {
  local candidate="$1"
  local mapping main_first main_last extra
  local candidate_parent main_parent candidate_numstat main_numstat

  mapping="$(awk -v candidate="$candidate" '$1 == candidate { print $2, $3; exit }' \
    .github/maintenance-release-backports)"
  if [ -z "$mapping" ]; then
    return 1
  fi
  read -r main_first main_last extra <<< "$mapping"
  if [ -n "$extra" ] \
    || ! git merge-base --is-ancestor "$main_first" "$main_last" \
    || ! git merge-base --is-ancestor "$main_last" "$default_ref"; then
    return 1
  fi

  # The approved release SHA is the review boundary. Matching per-file line
  # counts and ordered additions allows only baseline-specific removed lines.
  candidate_parent="$(git rev-parse "${candidate}^")"
  main_parent="$(git rev-parse "${main_first}^")"
  candidate_numstat="$(
    git diff --no-renames --numstat "$candidate_parent" "$candidate" -- . ':!CHANGELOG.md' \
      | LC_ALL=C sort
  )"
  main_numstat="$(
    git diff --no-renames --numstat "$main_parent" "$main_last" -- . ':!CHANGELOG.md' \
      | LC_ALL=C sort
  )"
  [ "$candidate_numstat" = "$main_numstat" ] \
    && [ "$(added_lines "$candidate_parent" "$candidate")" \
      = "$(added_lines "$main_parent" "$main_last")" ]
}

# Verify every functional patch verbatim before git cherry performs its
# whitespace-insensitive patch filtering.
while IFS= read -r candidate; do
  unexpected_paths="$(
    git diff-tree --no-commit-id --name-only -r "$candidate" \
      | grep -v '^CHANGELOG.md$' \
      || true
  )"
  if [ -n "$unexpected_paths" ] && approved_backport_matches_default "$candidate"; then
    echo "Accepted approved conflict-adjusted backport ${candidate}."
    continue
  fi
  if [ -n "$unexpected_paths" ] && ! patch_matches_default "$candidate"; then
    echo "Commit ${candidate} contains release-only changes that do not exactly match ${default_ref}:"
    printf '%s\n' "$unexpected_paths"
    exit 1
  fi
done < <(git rev-list --reverse "${base_tag}..${commit}")

while read -r disposition candidate; do
  if [ "$disposition" != "+" ]; then
    continue
  fi
  unexpected_paths="$(
    git diff-tree --no-commit-id --name-only -r "$candidate" \
      | grep -v '^CHANGELOG.md$' \
      || true
  )"
  if [ -n "$unexpected_paths" ] \
    && ! approved_backport_matches_default "$candidate" \
    && ! patch_matches_default "$candidate"; then
    echo "Commit ${candidate} is not present on ${default_ref} and changes more than CHANGELOG.md:"
    printf '%s\n' "$unexpected_paths"
    exit 1
  fi
done < <(git cherry "$default_ref" "$commit" "$base_tag")

echo "Validated maintenance release ${target_version} at ${commit} from base ${base_tag}."
